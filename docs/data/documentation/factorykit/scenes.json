{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/FactoryKit\/documentation\/FactoryKit\/Scenes"},"hierarchy":{"paths":[["doc:\/\/FactoryKit\/documentation\/FactoryKit"]]},"schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"kind":"article","primaryContentSections":[{"kind":"content","content":[{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Container.shared"},{"text":" is not scene aware. It never was.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"On an iPhone with a single window you will never notice. On iPad with Split View or Stage Manager, or on the Mac, one process hosts several scenes at once. Every one of them resolves through the same ","type":"text"},{"type":"codeVoice","code":"Container.shared"},{"text":", with the same registrations and the same scope caches.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"That’s the problem in one sentence. Here’s what it looks like in practice.","type":"text"}]},{"code":["extension Container {","    var session: Factory<Session> { self { Session() }.cached }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Two windows, two accounts. Both windows ask ","type":"text"},{"type":"codeVoice","code":"Container.shared"},{"text":" for a session, and both get the same cached instance. Sign in on the left and the right window is suddenly looking at someone else’s data. Register a mock in one window and you’ve registered it in all of them.","type":"text"}]},{"text":"Why not just swap the shared container?","anchor":"Why-not-just-swap-the-shared-container","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"Because you can’t. ","type":"text"},{"type":"codeVoice","code":"Container.shared"},{"text":" is a ","type":"text"},{"type":"codeVoice","code":"@TaskLocal"},{"text":", and a task local is get-only. The only way to change what it returns is ","type":"text"},{"type":"codeVoice","code":"Container.$shared.withValue(_:)"},{"text":", and the new value lasts for that closure and the child tasks created inside it.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"There are other issues as well, but basically we need to stop trying to replace the global and figure out a way to give each scene its own container and let the views find it.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Fortunately, Apple gave us a solution. With a catch, of course.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Let’s dive in.","type":"text"}]},{"text":"One container per scene","anchor":"One-container-per-scene","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"Start by creating the container at the root of the scene and publish it in the environment under ","type":"text"},{"type":"codeVoice","code":"\\.container"},{"text":".","type":"text"}]},{"code":["@main","struct DemoApp: App {","    var body: some Scene {","        WindowGroup {","            SceneRoot()","        }","    }","}","","struct SceneRoot: View {","    @State private var sceneContainer = Container()","    var body: some View {","        ContentView()","            .environment(\\.container, sceneContainer)","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Put it in the scene root, not the app root. ","type":"text"},{"type":"codeVoice","code":"WindowGroup"},{"text":" instantiates ","type":"text"},{"type":"codeVoice","code":"SceneRoot"},{"text":" once per window, so each window gets its own ","type":"text"},{"type":"codeVoice","code":"@State"},{"text":" and its own ","type":"text"},{"type":"codeVoice","code":"Container"},{"text":". Put it in ","type":"text"},{"type":"codeVoice","code":"App"},{"text":" and you’ve built another global with extra steps.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The container lives exactly as long as the scene. When the window goes away, ","type":"text"},{"type":"codeVoice","code":"@State"},{"text":" releases the container, and its registrations and cached objects go with it.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The default value of ","type":"text"},{"type":"codeVoice","code":"\\.container"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"Container.shared"},{"text":". Any view that isn’t inside a scene root behaves exactly as it always did.","type":"text"}]},{"text":"Accessing the container","anchor":"Accessing-the-container","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"So now we have our container. How do we access it? Well, in some cases we can simply access the environment variable.","type":"text"}]},{"code":["struct ContentView: View {","    @Environment(\\.container) var container","    ...","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"But there’s a problem here. The Environment isn’t available on View initialization, and that’s where we usually need to construct our view models or setup access to our repositories or other services.","type":"text"}]},{"code":["struct ContentView: View {","    @Environment(\\.container) var container","    @State var model: ContentViewModel","    init() {","        model = .init(container: container) \/\/ FAILS! Container not available!","    }","    var body: some View {","        Text(model.text)","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Fortunately, Factory has long had a solution to this problem. All you need to do is let Factory construct your view model for you.","type":"text"}]},{"text":"InjectedObject and InjectedObservable","anchor":"InjectedObject-and-InjectedObservable","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/FactoryKit\/documentation\/FactoryKit\/InjectedObservable","type":"reference","isActive":true},{"text":" and ","type":"text"},{"identifier":"doc:\/\/FactoryKit\/documentation\/FactoryKit\/InjectedObject","type":"reference","isActive":true},{"text":" both read ","type":"text"},{"type":"codeVoice","code":"\\.container"},{"text":" and resolve their dependencies from whatever container they find there.","type":"text"}]},{"code":["struct ContentView: View {","    @InjectedObservable(\\.contentViewModel) var model","    var body: some View {","        Text(model.text)","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"identifier":"doc:\/\/FactoryKit\/documentation\/FactoryKit\/InjectedObject","type":"reference","isActive":true},{"text":" the same way when your view model is an ","type":"text"},{"type":"codeVoice","code":"ObservableObject"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"There’s one behavioral detail worth knowing. A property wrapper can’t read the environment in its initializer, because the environment isn’t installed yet. So these wrappers resolve on first access instead, once, and keep the result in ","type":"text"},{"type":"codeVoice","code":"State"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"StateObject"},{"text":" for the lifetime of the view. The view model is still created exactly once per view.","type":"text"}]},{"text":"Pass the container down","anchor":"Pass-the-container-down","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"Resolving the view model from the scene container is only half the job. The view model has dependencies of its own, and those need to come from the same place.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The factory already knows which container is resolving it. It’s ","type":"text"},{"type":"codeVoice","code":"self"},{"text":". Hand it to the view model. So do this…","type":"text"}]},{"code":["extension Container {","    @MainActor var contentViewModel: Factory<ContentViewModel> {","        self { ContentViewModel(container: self) }","    }","}","","@MainActor @Observable","final class ContentViewModel {","    private let service: MyServiceType","    init(container: Container) {","        \/\/ Resolved from the scene container.","        self.service = container.myServiceType()","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"And don’t do this.","type":"text"}]},{"code":["@MainActor @Observable","final class ContentViewModel {","    \/\/ Always resolves from Container.shared, no matter which scene created the view model.","    @Injected(\\.myServiceType) private var badDependency","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The same goes inside factory definitions. Use ","type":"text"},{"type":"codeVoice","code":"self.network()"},{"text":", not ","type":"text"},{"type":"codeVoice","code":"Container.shared.network()"},{"text":". The second one jumps straight back to the global container.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"It may be that some dependencies can be shared across windows (analytics, for example). In that case you’d probably want them in the ","type":"text"},{"type":"codeVoice","code":".singleton"},{"text":" cache that’s shared across containers.","type":"text"}]},{"text":"What does not follow the scene container","anchor":"What-does-not-follow-the-scene-container","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"The environment only reaches the two aforementioned SwiftUI wrappers, and only when you use the default container’s key path.","type":"text"}]},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/FactoryKit\/documentation\/FactoryKit\/Injected","type":"reference","isActive":true},{"text":", ","type":"text"},{"identifier":"doc:\/\/FactoryKit\/documentation\/FactoryKit\/LazyInjected","type":"reference","isActive":true},{"text":", ","type":"text"},{"identifier":"doc:\/\/FactoryKit\/documentation\/FactoryKit\/WeakLazyInjected","type":"reference","isActive":true},{"text":", ","type":"text"},{"identifier":"doc:\/\/FactoryKit\/documentation\/FactoryKit\/DynamicInjected","type":"reference","isActive":true},{"text":" and a bare ","type":"text"},{"type":"codeVoice","code":"Container.shared.myService()"},{"text":" always use ","type":"text"},{"type":"codeVoice","code":"Container.shared"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"They have no way to see the environment."}],"type":"strong"}]},{"type":"paragraph","inlineContent":[{"text":"The custom container form, ","type":"text"},{"type":"codeVoice","code":"@InjectedObservable(\\MyContainer.service)"},{"text":", resolves from ","type":"text"},{"type":"codeVoice","code":"MyContainer.shared"},{"text":" as well. If you need per-scene behavior, use the default ","type":"text"},{"type":"codeVoice","code":"Container"},{"text":" or explicitly pass your own container in the environment.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Scopes behave the way you’d expect once you remember where they live. ","type":"text"},{"type":"codeVoice","code":".cached"},{"text":" and ","type":"text"},{"type":"codeVoice","code":".shared"},{"text":" are stored on the container, so they’re per scene. ","type":"text"},{"type":"codeVoice","code":".singleton"},{"text":" is global and independent of any container, so it’s shared by every scene. If a dependency must not be shared across windows, don’t make it a singleton.","type":"text"}]},{"text":"Previews and withContainer","anchor":"Previews-and-withContainer","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"A preview has no scene root, so ","type":"text"},{"type":"codeVoice","code":"\\.container"},{"text":" is the global container. You’ll usually want to register a mock for the preview, and ","type":"text"},{"type":"codeVoice","code":"withContainer"},{"text":" does that without leaving the view hierarchy.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Register one factory with the key path form.","type":"text"}]},{"code":["#Preview {","    ContentView()","        .withContainer(\\.myServiceType) { MockService() }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Or use the closure form when there’s more to set up.","type":"text"}]},{"code":["#Preview {","    ContentView()","        .withContainer {","            $0.myServiceType.register { MockService() }","            $0.analytics.register { MockAnalytics() }","        }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Remember what the default container is, though. In both previews above ","type":"text"},{"type":"codeVoice","code":"withContainer"},{"text":" finds ","type":"text"},{"type":"codeVoice","code":"Container.shared"},{"text":" and registers on it. That’s fine for a quick preview, but the registration can leak into other previews running in the same process.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"If you want the preview isolated, give it its own container.","type":"text"}]},{"code":["#Preview {","    ContentView()","        .withContainer { $0.myServiceType.register { MockService() } }","        .environment(\\.container, Container())","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Now the registration lands on a container that exists only for this preview.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The order of those two modifiers is not cosmetic. ","type":"text"},{"type":"codeVoice","code":"withContainer"},{"text":" changes the container it finds in the environment, so it has to sit inside the view that sets ","type":"text"},{"type":"codeVoice","code":"\\.container"},{"text":". Flip them and ","type":"text"},{"type":"codeVoice","code":"withContainer"},{"text":" runs first, finds ","type":"text"},{"type":"codeVoice","code":"Container.shared"},{"text":", and registers there. Your isolated container is created and never used, and nothing complains.","type":"text"}]},{"code":["\/\/ Wrong. The registration goes to Container.shared.","ContentView()","    .environment(\\.container, Container())","    .withContainer { $0.myServiceType.register { MockService() } }"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The same rule applies in a real scene root. To give one scene its own registrations, apply ","type":"text"},{"type":"codeVoice","code":"withContainer"},{"text":" inside the view that publishes the scene container.","type":"text"}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/factorykit\/scenes"]}],"metadata":{"role":"article","modules":[{"name":"FactoryKit"}],"title":"Per-Scene Containers","roleHeading":"Article"},"abstract":[{"type":"text","text":"Giving every window its own container instead of sharing one global."}],"seeAlsoSections":[{"generated":true,"title":"Advanced Topics","anchor":"Advanced-Topics","identifiers":["doc:\/\/FactoryKit\/documentation\/FactoryKit\/Modifiers","doc:\/\/FactoryKit\/documentation\/FactoryKit\/Actors","doc:\/\/FactoryKit\/documentation\/FactoryKit\/Modules","doc:\/\/FactoryKit\/documentation\/FactoryKit\/Cycle","doc:\/\/FactoryKit\/documentation\/FactoryKit\/Optionals","doc:\/\/FactoryKit\/documentation\/FactoryKit\/Functional","doc:\/\/FactoryKit\/documentation\/FactoryKit\/Tags"]}],"references":{"doc://FactoryKit/documentation/FactoryKit/Cycle":{"url":"\/documentation\/factorykit\/cycle","abstract":[{"type":"text","text":"What’s a resolution cycle, and why should we care?"}],"role":"article","identifier":"doc:\/\/FactoryKit\/documentation\/FactoryKit\/Cycle","type":"topic","kind":"article","title":"Resolution Cycles"},"doc://FactoryKit/documentation/FactoryKit/DynamicInjected":{"url":"\/documentation\/factorykit\/dynamicinjected","abstract":[{"type":"text","text":"Convenience property wrapper takes a factory and resolves an instance of the desired type."}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DynamicInjected","kind":"identifier"}],"identifier":"doc:\/\/FactoryKit\/documentation\/FactoryKit\/DynamicInjected","type":"topic","kind":"symbol","title":"DynamicInjected","navigatorTitle":[{"kind":"identifier","text":"DynamicInjected"}]},"doc://FactoryKit/documentation/FactoryKit/Tags":{"url":"\/documentation\/factorykit\/tags","abstract":[{"type":"text","text":"Obtaining a list of dependencies of a given type."}],"role":"article","identifier":"doc:\/\/FactoryKit\/documentation\/FactoryKit\/Tags","type":"topic","kind":"article","title":"Tags"},"doc://FactoryKit/documentation/FactoryKit/Modules":{"url":"\/documentation\/factorykit\/modules","abstract":[{"type":"text","text":"Using Factory in a project with multiple modules."}],"role":"article","identifier":"doc:\/\/FactoryKit\/documentation\/FactoryKit\/Modules","type":"topic","kind":"article","title":"Modular Development"},"doc://FactoryKit/documentation/FactoryKit/Functional":{"url":"\/documentation\/factorykit\/functional","abstract":[{"type":"text","text":"Factory can inject more than service classes and structs."}],"role":"article","identifier":"doc:\/\/FactoryKit\/documentation\/FactoryKit\/Functional","type":"topic","kind":"article","title":"Functional Injection"},"doc://FactoryKit/documentation/FactoryKit/WeakLazyInjected":{"identifier":"doc:\/\/FactoryKit\/documentation\/FactoryKit\/WeakLazyInjected","title":"WeakLazyInjected","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"WeakLazyInjected","kind":"identifier"}],"navigatorTitle":[{"text":"WeakLazyInjected","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/factorykit\/weaklazyinjected","type":"topic","role":"symbol","abstract":[{"type":"text","text":"Convenience property wrapper takes a factory and resolves a weak instance of the desired type the first time the wrapped value is requested."}]},"doc://FactoryKit/documentation/FactoryKit/InjectedObject":{"type":"topic","title":"InjectedObject","url":"\/documentation\/factorykit\/injectedobject","navigatorTitle":[{"text":"InjectedObject","kind":"identifier"}],"abstract":[{"text":"Injection property wrapper for SwiftUI ObservableObjects.","type":"text"}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"InjectedObject","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/FactoryKit\/documentation\/FactoryKit\/InjectedObject"},"doc://FactoryKit/documentation/FactoryKit/LazyInjected":{"role":"symbol","type":"topic","identifier":"doc:\/\/FactoryKit\/documentation\/FactoryKit\/LazyInjected","title":"LazyInjected","navigatorTitle":[{"text":"LazyInjected","kind":"identifier"}],"abstract":[{"type":"text","text":"Convenience property wrapper takes a factory and resolves an instance of the desired type the first time the wrapped value is requested."}],"kind":"symbol","url":"\/documentation\/factorykit\/lazyinjected","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"LazyInjected"}]},"doc://FactoryKit/documentation/FactoryKit/Modifiers":{"url":"\/documentation\/factorykit\/modifiers","abstract":[{"type":"text","text":"Considerations when defining and redefining a Factory’s behavior."}],"role":"article","identifier":"doc:\/\/FactoryKit\/documentation\/FactoryKit\/Modifiers","type":"topic","kind":"article","title":"Factory Modifiers"},"doc://FactoryKit/documentation/FactoryKit/Actors":{"identifier":"doc:\/\/FactoryKit\/documentation\/FactoryKit\/Actors","url":"\/documentation\/factorykit\/actors","title":"Actors and Actor Isolation","type":"topic","role":"article","abstract":[{"type":"text","text":"Registering and resolving actors and actor-isolated dependencies."}],"kind":"article"},"doc://FactoryKit/documentation/FactoryKit/Optionals":{"url":"\/documentation\/factorykit\/optionals","abstract":[{"type":"text","text":"With Factory registrations can be performed at any time."}],"role":"article","identifier":"doc:\/\/FactoryKit\/documentation\/FactoryKit\/Optionals","type":"topic","kind":"article","title":"Optionals and Dynamic Registration"},"doc://FactoryKit/documentation/FactoryKit":{"role":"collection","identifier":"doc:\/\/FactoryKit\/documentation\/FactoryKit","type":"topic","title":"FactoryKit","abstract":[{"type":"text","text":"A modern approach to Container-Based Dependency Injection for Swift and SwiftUI."}],"url":"\/documentation\/factorykit","kind":"symbol"},"doc://FactoryKit/documentation/FactoryKit/Injected":{"url":"\/documentation\/factorykit\/injected","abstract":[{"text":"Convenience property wrapper takes a factory and resolves an instance of the desired type.","type":"text"}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"Injected"}],"identifier":"doc:\/\/FactoryKit\/documentation\/FactoryKit\/Injected","type":"topic","kind":"symbol","title":"Injected","navigatorTitle":[{"text":"Injected","kind":"identifier"}]},"doc://FactoryKit/documentation/FactoryKit/InjectedObservable":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"InjectedObservable"}],"title":"InjectedObservable","identifier":"doc:\/\/FactoryKit\/documentation\/FactoryKit\/InjectedObservable","type":"topic","url":"\/documentation\/factorykit\/injectedobservable","abstract":[{"text":"A property wrapper that injects an Observable dependency into a SwiftUI view.","type":"text"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"InjectedObservable"}],"kind":"symbol"}}}