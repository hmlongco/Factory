{"schemaVersion":{"patch":0,"minor":3,"major":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/FactoryKit\/documentation\/FactoryKit\/Previews"},"variants":[{"paths":["\/documentation\/factorykit\/previews"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"article","sections":[],"hierarchy":{"paths":[["doc:\/\/FactoryKit\/documentation\/FactoryKit"]]},"metadata":{"title":"SwiftUI Previews","role":"article","modules":[{"name":"FactoryKit"}],"roleHeading":"Article"},"abstract":[{"text":"Mocking dependencies for SwiftUI Previews.","type":"text"}],"seeAlsoSections":[{"identifiers":["doc:\/\/FactoryKit\/documentation\/FactoryKit\/SwiftUI","doc:\/\/FactoryKit\/documentation\/FactoryKit\/Testing","doc:\/\/FactoryKit\/documentation\/FactoryKit\/Contexts","doc:\/\/FactoryKit\/documentation\/FactoryKit\/Debugging","doc:\/\/FactoryKit\/documentation\/FactoryKit\/Chains"],"generated":true,"title":"Development and Testing","anchor":"Development-and-Testing"}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"anchor":"Overview","type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Factory can make SwiftUI Previews easier when we’re using View Models and those view models depend on internal dependencies. Let’s take a look."}]},{"text":"SwiftUI Previews","level":2,"anchor":"SwiftUI-Previews","type":"heading"},{"inlineContent":[{"text":"Here’s an example of updating a view model’s service dependency in order to setup a particular state for  preview.","type":"text"}],"type":"paragraph"},{"code":["\/\/ the view model","class ContentViewModel: ObservableObject {","    @Injected(\\.myService) private var service","    ...","    func load() async {","        let results = await service.load()","        ...","    }","}","","\/\/ the view","struct ContentView: View {","    @StateObject var viewModel = ContentViewModel()","    var body: some View {","        ...","    }","}","","\/\/ the preview","struct ContentView_Previews: PreviewProvider {","    static var previews: some View {","        ContentView()","            .withContainer(\\.myService) { MockService() }","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"If we can control where and how the view model gets its data then we can put the view model into pretty much any state we choose.","type":"text"}]},{"level":2,"anchor":"SwiftUI-Previews","type":"heading","text":"SwiftUI #Previews"},{"type":"paragraph","inlineContent":[{"text":"The same can be done using the new macro-based #Preview option added to Xcode 15.","type":"text"}]},{"code":["#Preview {","    ContentView()","        .withContainer(\\.myService) { MockService() }","}"],"type":"codeListing","syntax":"swift"},{"text":"Multiple Registrations","level":2,"anchor":"Multiple-Registrations","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"There’s also a variant for Containers if you need to do multiple registrations.","type":"text"}]},{"code":["#Preview {","    ContentView()","        .withContainer {","            $0.myService.register { MockService() }","            $0.analytics.register { MockAnalytics() }","        }","}"],"type":"codeListing","syntax":"swift"},{"level":2,"type":"heading","anchor":"Multiple-Previews","text":"Multiple Previews"},{"type":"paragraph","inlineContent":[{"text":"If we want to do multiple previews at once, each with different data, we simply need to instantiate our view models and pass them into the view as parameters.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Prior to Xcode 15 and given the ContentView we used above, we’d need to do:"}]},{"type":"codeListing","syntax":"swift","code":["struct ContentView_Previews: PreviewProvider {","    static var previews: some View {","        Group {","            Container.shared.myService { MockServiceN(4) }","            let vm1 = ContentViewModel()","            ContentView(viewModel: vm1)","            ","            Container.shared.myService { MockServiceN(8) }","            let vm2 = ContentViewModel()","            ContentView(viewModel: vm2)","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"emphasis","inlineContent":[{"text":"Note the deprecated registration syntax.","type":"text"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Of course, it’s even easier with #Preview as each one runs in its own context.."}]},{"code":["#Preview {","    ContentView()","        .withContainer(\\.myService) { MockServiceN(4) }","}","#Preview {","    ContentView()","        .withContainer(\\.myService) { MockServiceN(0) }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Since the #Preview macro has been back-ported to iOS 13, there’s really no need to use the old syntax."}]},{"type":"heading","level":2,"text":"Common Setup","anchor":"Common-Setup"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If we have several mocks that we use all of the time in our previews or unit tests, we can also add a setup function to a given container to make this easier."}]},{"type":"codeListing","code":["extension Container {","    func setupMocks() {","        myService { MockServiceN(4) }","        sharedService { MockService2() }","    }","}","","#Preview {","    ContentView()","        .withContainer { $0.setupMocks() }","}"],"syntax":"swift"}]}],"references":{"doc://FactoryKit/documentation/FactoryKit/Debugging":{"type":"topic","identifier":"doc:\/\/FactoryKit\/documentation\/FactoryKit\/Debugging","title":"Debugging","kind":"article","url":"\/documentation\/factorykit\/debugging","abstract":[{"text":"Additional support for debugging resolution cycles, dependency chains and other issue.","type":"text"}],"role":"article"},"doc://FactoryKit/documentation/FactoryKit/Contexts":{"kind":"article","title":"Contexts","abstract":[{"type":"text","text":"Changing injection results under special circumstances."}],"type":"topic","url":"\/documentation\/factorykit\/contexts","role":"article","identifier":"doc:\/\/FactoryKit\/documentation\/FactoryKit\/Contexts"},"doc://FactoryKit/documentation/FactoryKit/Testing":{"role":"article","abstract":[{"text":"Using Factory for Unit and UI Testing.","type":"text"}],"title":"Testing","type":"topic","url":"\/documentation\/factorykit\/testing","kind":"article","identifier":"doc:\/\/FactoryKit\/documentation\/FactoryKit\/Testing"},"doc://FactoryKit/documentation/FactoryKit/SwiftUI":{"type":"topic","identifier":"doc:\/\/FactoryKit\/documentation\/FactoryKit\/SwiftUI","title":"SwiftUI","kind":"article","url":"\/documentation\/factorykit\/swiftui","abstract":[{"type":"text","text":"Defining and using dependencies in SwiftUI."}],"role":"article"},"doc://FactoryKit/documentation/FactoryKit":{"type":"topic","title":"FactoryKit","identifier":"doc:\/\/FactoryKit\/documentation\/FactoryKit","kind":"symbol","role":"collection","url":"\/documentation\/factorykit","abstract":[{"type":"text","text":"A modern approach to Container-Based Dependency Injection for Swift and SwiftUI."}]},"doc://FactoryKit/documentation/FactoryKit/Chains":{"type":"topic","identifier":"doc:\/\/FactoryKit\/documentation\/FactoryKit\/Chains","kind":"article","title":"Circular Dependency Chains","url":"\/documentation\/factorykit\/chains","abstract":[{"type":"text","text":"Detecting and solving Circular Dependency Chains."}],"role":"article"}}}