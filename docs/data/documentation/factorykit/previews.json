{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/FactoryKit\/documentation\/FactoryKit\/Previews"},"hierarchy":{"paths":[["doc:\/\/FactoryKit\/documentation\/FactoryKit"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/factorykit\/previews"]}],"metadata":{"title":"SwiftUI Previews","roleHeading":"Article","modules":[{"name":"FactoryKit"}],"role":"article"},"schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"kind":"article","abstract":[{"text":"Mocking dependencies for SwiftUI Previews.","type":"text"}],"seeAlsoSections":[{"anchor":"Development-and-Testing","generated":true,"identifiers":["doc:\/\/FactoryKit\/documentation\/FactoryKit\/SwiftUI","doc:\/\/FactoryKit\/documentation\/FactoryKit\/Testing","doc:\/\/FactoryKit\/documentation\/FactoryKit\/Contexts","doc:\/\/FactoryKit\/documentation\/FactoryKit\/Debugging","doc:\/\/FactoryKit\/documentation\/FactoryKit\/Chains"],"title":"Development and Testing"}],"primaryContentSections":[{"content":[{"level":2,"anchor":"Overview","text":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"Factory can make SwiftUI Previews easier when we’re using View Models and those view models depend on internal dependencies. Let’s take a look."}],"type":"paragraph"},{"level":2,"anchor":"SwiftUI-Previews","text":"SwiftUI Previews","type":"heading"},{"inlineContent":[{"type":"text","text":"Here’s an example of updating a view model’s service dependency in order to setup a particular state for  preview."}],"type":"paragraph"},{"code":["\/\/ the view model","class ContentViewModel: ObservableObject {","    @Injected(\\.myService) private var service","    ...","    func load() async {","        let results = await service.load()","        ...","    }","}","","\/\/ the view","struct ContentView: View {","    @StateObject var viewModel = ContentViewModel()","    var body: some View {","        ...","    }","}","","\/\/ the preview","struct ContentView_Previews: PreviewProvider {","    static var previews: some View {","        ContentView()","            .withContainer(\\.myService) { MockService() }","    }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"If we can control where and how the view model gets its data then we can put the view model into pretty much any state we choose."}],"type":"paragraph"},{"level":2,"anchor":"SwiftUI-Previews","text":"SwiftUI #Previews","type":"heading"},{"inlineContent":[{"type":"text","text":"The same can be done using the new macro-based #Preview option added to Xcode 15."}],"type":"paragraph"},{"code":["#Preview {","    ContentView()","        .withContainer(\\.myService) { MockService() }","}"],"type":"codeListing","syntax":"swift"},{"level":2,"anchor":"Multiple-Registrations","text":"Multiple Registrations","type":"heading"},{"inlineContent":[{"type":"text","text":"There’s also a variant for Containers if you need to do multiple registrations."}],"type":"paragraph"},{"code":["#Preview {","    ContentView()","        .withContainer {","            $0.myService.register { MockService() }","            $0.analytics.register { MockAnalytics() }","        }","}"],"type":"codeListing","syntax":"swift"},{"level":2,"anchor":"Multiple-Previews","text":"Multiple Previews","type":"heading"},{"inlineContent":[{"type":"text","text":"If we want to do multiple previews at once, each with different data, we simply need to instantiate our view models and pass them into the view as parameters."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Prior to Xcode 15 and given the ContentView we used above, we’d need to do:"}],"type":"paragraph"},{"code":["struct ContentView_Previews: PreviewProvider {","    static var previews: some View {","        Group {","            Container.shared.myService { MockServiceN(4) }","            let vm1 = ContentViewModel()","            ContentView(viewModel: vm1)","            ","            Container.shared.myService { MockServiceN(8) }","            let vm2 = ContentViewModel()","            ContentView(viewModel: vm2)","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"inlineContent":[{"text":"Note the deprecated registration syntax.","type":"text"}],"type":"emphasis"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Of course, it’s even easier with #Preview as each one runs in its own context.."}],"type":"paragraph"},{"code":["#Preview {","    ContentView()","        .withContainer(\\.myService) { MockServiceN(4) }","}","#Preview {","    ContentView()","        .withContainer(\\.myService) { MockServiceN(0) }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Since the #Preview macro has been back-ported to iOS 13, there’s really no need to use the old syntax."}],"type":"paragraph"},{"level":2,"anchor":"Common-Setup","text":"Common Setup","type":"heading"},{"inlineContent":[{"type":"text","text":"If we have several mocks that we use all of the time in our previews or unit tests, we can also add a setup function to a given container to make this easier."}],"type":"paragraph"},{"code":["extension Container {","    func setupMocks() {","        myService { MockServiceN(4) }","        sharedService { MockService2() }","    }","}","","#Preview {","    ContentView()","        .withContainer { $0.setupMocks() }","}"],"type":"codeListing","syntax":"swift"}],"kind":"content"}],"references":{"doc://FactoryKit/documentation/FactoryKit":{"role":"collection","identifier":"doc:\/\/FactoryKit\/documentation\/FactoryKit","type":"topic","title":"FactoryKit","abstract":[{"type":"text","text":"A modern approach to Container-Based Dependency Injection for Swift and SwiftUI."}],"url":"\/documentation\/factorykit","kind":"symbol"},"doc://FactoryKit/documentation/FactoryKit/Contexts":{"url":"\/documentation\/factorykit\/contexts","abstract":[{"type":"text","text":"Changing injection results under special circumstances."}],"role":"article","identifier":"doc:\/\/FactoryKit\/documentation\/FactoryKit\/Contexts","type":"topic","kind":"article","title":"Contexts"},"doc://FactoryKit/documentation/FactoryKit/Debugging":{"identifier":"doc:\/\/FactoryKit\/documentation\/FactoryKit\/Debugging","url":"\/documentation\/factorykit\/debugging","title":"Debugging","type":"topic","role":"article","abstract":[{"type":"text","text":"Additional support for debugging resolution cycles, dependency chains and other issue."}],"kind":"article"},"doc://FactoryKit/documentation/FactoryKit/Chains":{"identifier":"doc:\/\/FactoryKit\/documentation\/FactoryKit\/Chains","url":"\/documentation\/factorykit\/chains","title":"Circular Dependency Chains","type":"topic","role":"article","abstract":[{"text":"Detecting and solving Circular Dependency Chains.","type":"text"}],"kind":"article"},"doc://FactoryKit/documentation/FactoryKit/SwiftUI":{"url":"\/documentation\/factorykit\/swiftui","abstract":[{"type":"text","text":"Defining and using dependencies in SwiftUI."}],"role":"article","identifier":"doc:\/\/FactoryKit\/documentation\/FactoryKit\/SwiftUI","type":"topic","kind":"article","title":"SwiftUI"},"doc://FactoryKit/documentation/FactoryKit/Testing":{"url":"\/documentation\/factorykit\/testing","abstract":[{"text":"Using Factory for Unit and UI Testing.","type":"text"}],"role":"article","identifier":"doc:\/\/FactoryKit\/documentation\/FactoryKit\/Testing","type":"topic","kind":"article","title":"Testing"}}}