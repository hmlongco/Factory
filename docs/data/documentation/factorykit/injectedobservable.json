{"abstract":[{"type":"text","text":"A property wrapper that injects an Observable dependency into a SwiftUI view."}],"variants":[{"paths":["\/documentation\/factorykit\/injectedobservable"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"url":"doc:\/\/FactoryKit\/documentation\/FactoryKit\/InjectedObservable","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/FactoryKit\/documentation\/FactoryKit"]]},"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"attribute","text":"@"},{"kind":"attribute","preciseIdentifier":"s:ScM","text":"MainActor"},{"kind":"text","text":" "},{"kind":"attribute","text":"@propertyWrapper"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"InjectedObservable"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"T"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"T"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:11Observation10ObservableP","text":"Observable"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"mentions":["doc:\/\/FactoryKit\/documentation\/FactoryKit\/Scenes"],"kind":"mentions"},{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"InjectedObservable"},{"type":"text","text":" is designed to automatically resolve and inject Observable dependencies"},{"type":"text","text":" "},{"type":"text","text":"from a shared container, allowing for easy management of Observable objects within"},{"type":"text","text":" "},{"type":"text","text":"SwiftUI views. This property wrapper ensures that the dependency is resolved on"},{"type":"text","text":" "},{"type":"text","text":"first use and provides state storage, direct access, and binding capabilities."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"And unlike using State (prior to iOS 27), the injected dependency is only resolved once, on first use."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To use "},{"type":"codeVoice","code":"InjectedObservable"},{"type":"text","text":" just add the view model dependency to a Factory container."}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Define the dependency","extension Container {","    @MainActor var sceneDemoViewModel: Factory<SceneDemoViewModel> {","        self { SceneDemoViewModel() }","    }","}","\/\/ And use the property wrapper in the View to obtain the view model.","struct SceneDemoView: View {","    @InjectedObservable(\\.sceneDemoViewModel) var model","    var body: some View {","        Text(model.text)","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"InjectedObservable"},{"type":"text","text":" can also look for a registered scene container and use that container instead of Container.shared. This can be"},{"type":"text","text":" "},{"type":"text","text":"beneficial in multitasking environments like SplitView."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To do so, register and store the container at the scene root, NOT the app root."}]},{"type":"codeListing","syntax":"swift","code":["@main","struct DemoApp: App {","    var body: some Scene {","        WindowGroup {","            PerSceneContentView()","        }","    }","}","\/\/ Create a new container for each scene.","struct PerSceneContentView: View {","    @State var sceneContainer = Container()","    var body: some View {","        ContentView()","            .environment(\\.container, sceneContainer)","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You’ll probably also want to pass the container into the view model on initialization so it’s accessing the proper dependencies. Using"},{"type":"text","text":" "},{"type":"codeVoice","code":"@Injected"},{"type":"text","text":" or other Factory property wrappers will revert to accessing "},{"type":"codeVoice","code":"Container.shared"},{"type":"text","text":", which is not what we want."}]},{"type":"codeListing","syntax":"swift","code":["extension Container {","    @MainActor var sceneDemoViewModel: Factory<SceneDemoViewModel> {","        self { SceneDemoViewModel(container: self) }","    }","}","","@MainActor","@Observable","final class SceneDemoViewModel {","    private let service: MyServiceType","    init(container: Container) {","        \/\/ If you want the service resolved from the \"per scene\" container do this!","        self.service = container.myServiceType()","    }","    \/\/ Not this!","    @Injected(\\.myServiceType) private var badDependency","}"]},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"This property wrapper is available on iOS 17.0, macOS 14.0, tvOS 17.0, and watchOS 10.0.","type":"text"}]}],"style":"note","name":"Note"},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"The wrapped type ","type":"text"},{"code":"T","type":"codeVoice"},{"text":" must conform to the ","type":"text"},{"code":"Observable","type":"codeVoice"},{"text":" protocol.","type":"text"}]}],"style":"note","name":"Requires"}],"kind":"content"}],"sections":[],"metadata":{"modules":[{"name":"FactoryKit"}],"platforms":[{"deprecated":false,"beta":false,"introducedAt":"17.0","unavailable":false,"name":"iOS"},{"deprecated":false,"beta":false,"introducedAt":"17.0","unavailable":false,"name":"iPadOS"},{"deprecated":false,"beta":false,"introducedAt":"17.0","unavailable":false,"name":"Mac Catalyst"},{"deprecated":false,"beta":false,"introducedAt":"14.0","unavailable":false,"name":"macOS"},{"deprecated":false,"beta":false,"introducedAt":"17.0","unavailable":false,"name":"tvOS"},{"deprecated":false,"beta":false,"introducedAt":"10.0","unavailable":false,"name":"watchOS"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"InjectedObservable"}],"navigatorTitle":[{"kind":"identifier","text":"InjectedObservable"}],"symbolKind":"struct","title":"InjectedObservable","roleHeading":"Structure","role":"symbol","externalID":"s:10FactoryKit18InjectedObservableV"},"topicSections":[{"generated":true,"anchor":"Initializers","title":"Initializers","identifiers":["doc:\/\/FactoryKit\/documentation\/FactoryKit\/InjectedObservable\/init(_:)-5387n","doc:\/\/FactoryKit\/documentation\/FactoryKit\/InjectedObservable\/init(_:)-8hen6","doc:\/\/FactoryKit\/documentation\/FactoryKit\/InjectedObservable\/init(_:)-zktg"]},{"generated":true,"anchor":"Instance-Properties","title":"Instance Properties","identifiers":["doc:\/\/FactoryKit\/documentation\/FactoryKit\/InjectedObservable\/projectedValue","doc:\/\/FactoryKit\/documentation\/FactoryKit\/InjectedObservable\/wrappedValue"]},{"generated":true,"anchor":"Default-Implementations","title":"Default Implementations","identifiers":["doc:\/\/FactoryKit\/documentation\/FactoryKit\/InjectedObservable\/DynamicProperty-Implementations"]}],"relationshipsSections":[{"identifiers":["doc:\/\/FactoryKit\/s8SendableP","doc:\/\/FactoryKit\/s16SendableMetatypeP","doc:\/\/FactoryKit\/7SwiftUI15DynamicPropertyP"],"type":"conformsTo","title":"Conforms To","kind":"relationships"}],"references":{"doc://FactoryKit/documentation/FactoryKit/InjectedObservable/init(_:)-5387n":{"type":"topic","title":"init(_:)","abstract":[{"type":"text","text":"Initializes the "},{"type":"codeVoice","code":"InjectedObservable"},{"type":"text","text":" property wrapper, resolving the dependency from the default shared container."}],"url":"\/documentation\/factorykit\/injectedobservable\/init(_:)-5387n","identifier":"doc:\/\/FactoryKit\/documentation\/FactoryKit\/InjectedObservable\/init(_:)-5387n","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"KeyPath","kind":"typeIdentifier","preciseIdentifier":"s:s7KeyPathC"},{"text