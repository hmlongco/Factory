{"primaryContentSections":[{"declarations":[{"tokens":[{"text":"@","kind":"attribute"},{"text":"MainActor","preciseIdentifier":"s:ScM","kind":"attribute"},{"text":" ","kind":"text"},{"text":"@propertyWrapper","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"InjectedObject","kind":"identifier"},{"text":"<","kind":"text"},{"text":"T","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"T","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"ObservableObject","preciseIdentifier":"s:7Combine16ObservableObjectP","kind":"typeIdentifier"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"},{"mentions":["doc:\/\/FactoryKit\/documentation\/FactoryKit\/Scenes","doc:\/\/FactoryKit\/documentation\/FactoryKit\/Containers","doc:\/\/FactoryKit\/documentation\/FactoryKit\/Design","doc:\/\/FactoryKit\/documentation\/FactoryKit\/Migration","doc:\/\/FactoryKit\/documentation\/FactoryKit\/Resolutions"],"kind":"mentions"},{"content":[{"level":2,"type":"heading","anchor":"overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This wrapper is meant for use in SwiftUI Views and exposes bindable objects similar to that of SwiftUI @StateObject"},{"type":"text","text":" "},{"type":"text","text":"and @EnvironmentObject."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Like the other Injected property wrappers, InjectedObject obtains the dependency from the Factory keypath"},{"type":"text","text":" "},{"type":"text","text":"and provides it to a wrapped instance of StateObject. Updating object state will trigger view update."}]},{"syntax":"swift","type":"codeListing","code":["struct ContentView: View {","    @InjectedObject(\\.contentViewModel) var model","    var body: some View {","        ...","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"ContentViewModel must, of course, be of type ObservableObject and is registered like any other service"},{"type":"text","text":" "},{"type":"text","text":"or dependency."}]},{"syntax":"swift","type":"codeListing","code":["extension Container {","    var contentViewModel: Factory<ContentViewModel> {","        self { ContentViewModel() }","    }","}"]},{"type":"paragraph","inlineContent":[{"code":"InjectedObject","type":"codeVoice"},{"type":"text","text":" can also look for a registered scene container and use that container instead of Container.shared. This can be"},{"type":"text","text":" "},{"type":"text","text":"beneficial in multitasking environments like SplitView."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To do so, register and store the container at the scene root, NOT the app root."}]},{"syntax":"swift","type":"codeListing","code":["@main","struct DemoApp: App {","    var body: some Scene {","        WindowGroup {","            PerSceneContentView()","        }","    }","}","\/\/ Create a new container for each scene.","struct PerSceneContentView: View {","    @State var sceneContainer = Container()","    var body: some View {","        ContentView()","            .environment(\\.container, sceneContainer)","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You’ll probably also want to pass the container into the view model on initialization so it’s accessing the proper dependencies. Using"},{"type":"text","text":" "},{"code":"@Injected","type":"codeVoice"},{"type":"text","text":" or other Factory property wrappers will revert to accessing "},{"code":"Container.shared","type":"codeVoice"},{"type":"text","text":", which is not what we want."}]},{"syntax":"swift","type":"codeListing","code":["extension Container {","    @MainActor var contentViewModel: Factory<ContentViewModel> {","        self { ContentViewModel(container: self) }","    }","}","","@MainActor","final class ContentViewModel: ObservableObject {","    private let service: MyServiceType","    init(container: Container) {","        \/\/ If you want the service resolved from the \"per scene\" container do this!","        self.service = container.myServiceType()","    }","    \/\/ Not this!","    @Injected(\\.myServiceType) private var badDependency","}"]}],"kind":"content"}],"relationshipsSections":[{"title":"Conforms To","kind":"relationships","type":"conformsTo","identifiers":["doc:\/\/FactoryKit\/s8SendableP","doc:\/\/FactoryKit\/s16SendableMetatypeP","doc:\/\/FactoryKit\/7SwiftUI15DynamicPropertyP"]}],"hierarchy":{"paths":[["doc:\/\/FactoryKit\/documentation\/FactoryKit"]]},"abstract":[{"type":"text","text":"Injection property wrapper for SwiftUI ObservableObjects."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/factorykit\/injectedobject"]}],"topicSections":[{"title":"Initializers","generated":true,"anchor":"Initializers","identifiers":["doc:\/\/FactoryKit\/documentation\/FactoryKit\/InjectedObject\/init(_:)-5is4r","doc:\/\/FactoryKit\/documentation\/FactoryKit\/InjectedObject\/init(_:)-81kt","doc:\/\/FactoryKit\/documentation\/FactoryKit\/InjectedObject\/init(_:)-9z203"]},{"identifiers":["doc:\/\/FactoryKit\/documentation\/FactoryKit\/InjectedObject\/projectedValue","doc:\/\/FactoryKit\/documentation\/FactoryKit\/InjectedObject\/wrappedValue"],"anchor":"Instance-Properties","title":"Instance Properties","generated":true},{"title":"Default Implementations","generated":true,"anchor":"Default-Implementations","identifiers":["doc:\/\/FactoryKit\/documentation\/FactoryKit\/InjectedObject\/DynamicProperty-Implementations"]}],"sections":[],"schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"url":"doc:\/\/FactoryKit\/documentation\/FactoryKit\/InjectedObject","interfaceLanguage":"swift"},"metadata":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"text":"InjectedObject","kind":"identifier"}],"title":"InjectedObject","roleHeading":"Structure","role":"symbol"