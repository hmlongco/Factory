text":"beneficial in multitasking environments like SplitView.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To do so, register and store the container at the scene root, NOT the app root."}]},{"type":"codeListing","syntax":"swift","code":["@main","struct DemoApp: App {","    var body: some Scene {","        WindowGroup {","            PerSceneContentView()","        }","    }","}","\/\/ Create a new container for each scene.","struct PerSceneContentView: View {","    @State var sceneContainer = Container()","    var body: some View {","        ContentView()","            .environment(\\.container, sceneContainer)","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"You’ll probably also want to pass the container into the view model on initialization so it’s accessing the proper dependencies. Using","type":"text"},{"text":" ","type":"text"},{"code":"@Injected","type":"codeVoice"},{"text":" or other Factory property wrappers will revert to accessing ","type":"text"},{"type":"codeVoice","code":"Container.shared"},{"type":"text","text":", which is not what we want."}]},{"type":"codeListing","code":["extension Container {","    @MainActor var contentViewModel: Factory<ContentViewModel> {","        self { ContentViewModel(container: self) }","    }","}","","@MainActor","final class ContentViewModel: ObservableObject {","    private let service: MyServiceType","    init(container: Container) {","        \/\/ If you want the service resolved from the \"per scene\" container do this!","        self.service = container.myServiceType()","    }","    \/\/ Not this!","    @Injected(\\.myServiceType) private var badDependency","}"],"syntax":"swift"}]}],"kind":"symbol","variants":[{"paths":["\/documentation\/factorykit\/injectedobject"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/FactoryKit\/documentation\/FactoryKit"]]},"topicSections":[{"identifiers":["doc:\/\/