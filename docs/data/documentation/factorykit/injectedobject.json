perty wrapper for SwiftUI ObservableObjects.","type":"text"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/FactoryKit\/documentation\/FactoryKit\/InjectedObject"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"@","kind":"attribute"},{"text":"MainActor","kind":"attribute","preciseIdentifier":"s:ScM"},{"text":" ","kind":"text"},{"text":"@propertyWrapper","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"InjectedObject","kind":"identifier"},{"text":"<","kind":"text"},{"text":"T","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"T","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"ObservableObject","kind":"typeIdentifier","preciseIdentifier":"s:7Combine16ObservableObjectP"}],"languages":["swift"],"platforms":["macOS"]}]},{"kind":"mentions","mentions":["doc:\/\/FactoryKit\/documentation\/FactoryKit\/Scenes","doc:\/\/FactoryKit\/documentation\/FactoryKit\/Containers","doc:\/\/FactoryKit\/documentation\/FactoryKit\/Design","doc:\/\/FactoryKit\/documentation\/FactoryKit\/Migration","doc:\/\/FactoryKit\/documentation\/FactoryKit\/Resolutions"]},{"content":[{"text":"Overview","anchor":"overview","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"This wrapper is meant for use in SwiftUI Views and exposes bindable objects similar to that of SwiftUI @StateObject"},{"type":"text","text":" "},{"type":"text","text":"and @EnvironmentObject."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Like the other Injected property wrappers, InjectedObject obtains the dependency from the Factory keypath"},{"type":"text","text":" "},{"type":"text","text":"and provides it to a wrapped instance of StateObject. Updating object state will trigger view update."}],"type":"paragraph"},{"code":["struct ContentView: View {","    @InjectedObject(\\.contentViewModel) var model","    var body: some View {","        ...","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"ContentViewModel must, of course, be of type ObservableObject and is registered like any other service"},{"type":"text","text":" "},{"type":"text","text":"or dependency."}],"type":"paragraph"},{"code":["extension Container {","    var contentViewModel: Factory<ContentViewModel> {","        self { ContentViewModel() }","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"codeVoice","code":"InjectedObject"},{"type":"text","text":" can also look for a registered scene container and use that container instead of Container.shared. This can be"},{"type":"text","text":" "},{"type":"text","text":"beneficial in multitasking environments like SplitView."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"To do so, register and store the container at the scene root, NOT the app root."}],"type":"paragraph"},{"code":["@main","struct DemoApp: App {","    var body: some Scene {","        WindowGroup {","            PerSceneContentView()","        }","    }","}","\/\/ Create a new container for each scene.","struct PerSceneContentView: View {","    @State var sceneContainer = Container()","    var body: some View {","        ContentView()","            .environment(\\.container, sceneContainer)","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"You’ll probably also want to pass the container into the view model on initialization so it’s accessing the proper dependencies. Using"},{"type":"text","text":" "},{"type":"codeVoice","code":"@Injected"},{"type":"text","text":" or other Factory property wrappers will revert to accessing "},{"type":"codeVoice","code":"Container.shared"},{"type":"text","text":", which is not what we want."}],"type":"paragraph"},{"code":["extension Container {","    @MainActor var contentViewMo